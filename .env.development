# ===========================================
# Example Environment - Full Stack Template
# ===========================================

# Application
NODE_ENV=development
PORT=3000
BUILD_TARGET=development

# Database (PostgreSQL)
POSTGRES_HOST=db-postgres
POSTGRES_PORT=5432
POSTGRES_USER=user
POSTGRES_PASSWORD=user123456
POSTGRES_DB=user

# Redis Cache
REDIS_HOST=redis-dev
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL=3600
REDIS_MAX_ITEMS=100
REDIS_MAXMEMORY=512mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# Cache TTL (in seconds) - Backend
CACHE_TTL_DECEMBER_2019=86400
CACHE_TTL_TYPES=3600
CACHE_TTL_CITIES=21600
CACHE_TTL_BUILDINGS=43200
CACHE_TTL_ALL=900

# Redis Health Check Settings
REDIS_HEALTH_ALERT_COOLDOWN=300000  # 5 minutes in ms
REDIS_HEALTH_MAX_RETRY_TIME=3600000 # 1 hour in ms
REDIS_HEALTH_RETRY_DELAY=3000       # 3 seconds in ms
REDIS_HEALTH_MAX_FAILURES=3         # Max consecutive failures before alert

# Default Redis Hosts (fallback)
REDIS_HOST_DEV=redis-dev
REDIS_HOST_PROD=redis-prod

# Backup Settings
BACKUP_INTERVAL=600
KEEP_BACKUPS=20

# Debug
DEBUG=true
LOG_LEVEL=debug

# Frontend (Future)
# VITE_API_URL=http://localhost:3000
# VITE_APP_TITLE=Vladivostok Blackouts

# API Documentation
SWAGGER_PATH=api

# Monitoring (optional)
# MONITORING_WEBHOOK_URL=

# TypeORM Entity Generator (for development only)
TYPEORM_GEN_HOST=localhost
TYPEORM_GEN_PORT=5432
TYPEORM_GEN_DATABASE=user
TYPEORM_GEN_USER=user
TYPEORM_GEN_PASSWORD=user123456
CACHE_TTL_INITIATORS=21600
