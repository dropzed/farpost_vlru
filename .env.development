# ===========================================
# Development Environment Configuration
# ===========================================
# This file contains all environment variables for development mode

# ============================================
# Application Settings
# ============================================

# NODE_ENV - Environment mode (development/production)
# Used by NestJS to enable dev features like hot-reload, detailed errors
NODE_ENV=development

# PORT - Port number for backend API server
# Backend will be accessible at http://localhost:3000
PORT=3000

# BUILD_TARGET - Docker build target stage
# Options: development (with dev dependencies) or production (optimized)
BUILD_TARGET=development

# ============================================
# PostgreSQL Database Configuration
# ============================================

# POSTGRES_HOST - PostgreSQL server hostname
# Use 'db-postgres' for Docker Compose, 'localhost' for local development
POSTGRES_HOST=db-postgres

# POSTGRES_PORT - PostgreSQL server port
# Default PostgreSQL port
POSTGRES_PORT=5432

# POSTGRES_USER - PostgreSQL username
# Database user for authentication
POSTGRES_USER=user

# POSTGRES_PASSWORD - PostgreSQL password
POSTGRES_PASSWORD=user123456

# POSTGRES_DB - PostgreSQL database name
# Name of the database to connect to
POSTGRES_DB=user

# ============================================
# Redis Cache Configuration
# ============================================

# REDIS_HOST - Redis server hostname
# Use 'redis-dev' for Docker Compose, 'localhost' for local development
REDIS_HOST=redis-dev

# REDIS_PORT - Redis server port
# Default Redis port
REDIS_PORT=6379

# REDIS_PASSWORD - Redis authentication password
# Leave empty for no password (dev only)
REDIS_PASSWORD=

# REDIS_TTL - Default Time-To-Live for cache entries (seconds)
# How long cached data stays valid (1 hour = 3600 seconds) redis default use seconds
REDIS_TTL=3600

# REDIS_MAX_ITEMS - Maximum number of items in cache
# Limit cache size to prevent memory overflow
REDIS_MAX_ITEMS=100

# REDIS_MAXMEMORY - Maximum memory Redis can use
# Format: 512mb, 1gb, 2gb. Redis will evict keys when limit is reached
REDIS_MAXMEMORY=512mb

# REDIS_MAXMEMORY_POLICY - Eviction policy when maxmemory is reached
# allkeys-lru = Remove least recently used keys
# Other options: allkeys-lfu, volatile-lru, noeviction
REDIS_MAXMEMORY_POLICY=allkeys-lru

# ============================================
# Cache TTL Settings (seconds)
# ============================================
# Fine-grained TTL control for different data types

# CACHE_TTL_DECEMBER_2019 - data for December 2019
CACHE_TTL_DECEMBER_2019=86400

# CACHE_TTL_TYPES - Blackout types statistics
# 3600 seconds = 1 hour (updates periodically)
CACHE_TTL_TYPES=3600

# CACHE_TTL_CITIES - Cities list
# 21600 seconds = 6 hours (static data, rarely changes)
CACHE_TTL_CITIES=21600

# CACHE_TTL_BUILDINGS - Buildings with geolocation
# 43200 seconds = 12 hours (semi-static data)
CACHE_TTL_BUILDINGS=43200

# CACHE_TTL_ALL - All blackouts list
# 900 seconds = 15 minutes (frequently updated)
CACHE_TTL_ALL=900

# CACHE_TTL_INITIATORS - Management companies (initiators) list
# 21600 seconds = 6 hours (rarely changes)
CACHE_TTL_INITIATORS=21600

# ============================================
# Redis Health Check Configuration
# ============================================

# REDIS_HEALTH_ALERT_COOLDOWN - Cooldown between health alerts (milliseconds)
# 300000 ms = 5 minutes (prevents spam)
REDIS_HEALTH_ALERT_COOLDOWN=300000

# REDIS_HEALTH_MAX_RETRY_TIME - Maximum time to keep retrying (milliseconds)
# 3600000 ms = 1 hour (circuit breaker timeout)
REDIS_HEALTH_MAX_RETRY_TIME=3600000

# REDIS_HEALTH_RETRY_DELAY - Delay between retry attempts (milliseconds)
# 3000 ms = 3 seconds (exponential backoff base)
REDIS_HEALTH_RETRY_DELAY=3000

# REDIS_HEALTH_MAX_FAILURES - Max consecutive failures before alert
# Triggers alert after 3 failed connection attempts
REDIS_HEALTH_MAX_FAILURES=3

# ============================================
# Redis Hosts (Fallback Configuration)
# ============================================

# REDIS_HOST_DEV - Development Redis hostname
# Fallback value for development environment
REDIS_HOST_DEV=redis-dev

# ============================================
# Automated Backup System
# ============================================

# BACKUP_INTERVAL - Interval between automatic backups (seconds)
# 600 seconds = 10 minutes (frequent backups for development)
BACKUP_INTERVAL=600

# KEEP_BACKUPS - Number of backup files to retain
# 20 backups = ~3.5 hours of history with 10-minute intervals
# Older backups are automatically deleted
KEEP_BACKUPS=20

# ============================================
# Debugging & Logging
# ============================================

# DEBUG - Enable debug mode
# true = Show detailed logs, false = production mode logging
DEBUG=true

# LOG_LEVEL - Logging level
# Options: debug, info, warn, error
# 'debug' shows all logs including SQL queries
LOG_LEVEL=debug

# ============================================
# API Documentation (Swagger)
# ============================================

# SWAGGER_PATH - URL path for Swagger UI
# Access documentation at: http://localhost:3000/api
SWAGGER_PATH=api

# ============================================
# TypeORM Entity Generator (Development Only)
# ============================================
# Used for generating TypeORM entities from existing database schema
# Command: npm run generate:entities

# TYPEORM_GEN_HOST - Database host for entity generation
# Use 'localhost' when generating from local database
TYPEORM_GEN_HOST=localhost

# TYPEORM_GEN_PORT - Database port for entity generation
TYPEORM_GEN_PORT=5432

# TYPEORM_GEN_DATABASE - Database name for entity generation
TYPEORM_GEN_DATABASE=user

# TYPEORM_GEN_USER - Database user for entity generation
TYPEORM_GEN_USER=user

# TYPEORM_GEN_PASSWORD - Database password for entity generation
TYPEORM_GEN_PASSWORD=user123456
