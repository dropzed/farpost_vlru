# ===========================================
# Production Environment Configuration
# ===========================================

# ============================================
# Application Settings
# ============================================

# NODE_ENV - Environment mode (development/production)
# 'production' enables optimizations, disables debug features
NODE_ENV=production

# PORT - Port number for backend API server
PORT=3000

# BUILD_TARGET - Docker build target stage
# 'production' = optimized build without dev dependencies
BUILD_TARGET=production

# SWAGGER_PATH - URL path for Swagger UI
# Access API documentation at: http://your-domain:3000/api
# Consider disabling or protecting with auth in production
SWAGGER_PATH=api

# ============================================
# PostgreSQL Database Configuration
# ============================================

# POSTGRES_HOST - PostgreSQL server hostname - expample value
# Use 'db-postgres' for Docker Compose, or external DB hostname
POSTGRES_HOST=db-postgres

# POSTGRES_PORT - PostgreSQL server port - expample value
# Default PostgreSQL port
POSTGRES_PORT=5432

# POSTGRES_USER - PostgreSQL username - expample value
POSTGRES_USER=produser

# POSTGRES_PASSWORD - PostgreSQL password - expample value
# generate strong password
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_123

# POSTGRES_DB - PostgreSQL database name
# Production database name
POSTGRES_DB=blackouts

# ============================================
# Redis Cache Configuration
# ============================================
# ⚠️ SET STRONG PASSWORD FOR PRODUCTION REDIS!

# REDIS_HOST - Redis server hostname
# Use 'redis-prod' for Docker Compose, or external Redis hostname
REDIS_HOST=redis-prod

# REDIS_PORT - Redis server port
# Default Redis port
REDIS_PORT=6379

# REDIS_PASSWORD - Redis authentication password
# generate strong password
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD_456

# REDIS_TTL - Default Time-To-Live for cache entries (seconds)
# How long cached data stays valid (1 hour = 3600 seconds)
REDIS_TTL=3600

# REDIS_MAX_ITEMS - Maximum number of items in cache
# Higher limit for production to handle more traffic
REDIS_MAX_ITEMS=1000

# REDIS_MAXMEMORY - Maximum memory Redis can use
# 2gb recommended for production, adjust based on server capacity
# Monitor with: redis-cli INFO memory
REDIS_MAXMEMORY=2gb

# REDIS_MAXMEMORY_POLICY - Eviction policy when maxmemory is reached
# allkeys-lru = Remove least recently used keys (recommended for cache)
# Other options: allkeys-lfu, volatile-lru, noeviction
REDIS_MAXMEMORY_POLICY=allkeys-lru

# ============================================
# Cache TTL Settings (seconds)
# ============================================
# Fine-grained TTL control for different data types

# CACHE_TTL_DECEMBER_2019 - Historical data for December 2019
# 86400 seconds = 24 hours (static historical data)
CACHE_TTL_DECEMBER_2019=86400

# CACHE_TTL_TYPES - Blackout types statistics
# 3600 seconds = 1 hour (aggregated statistics)
CACHE_TTL_TYPES=3600

# CACHE_TTL_CITIES - Cities list
# 21600 seconds = 6 hours (rarely changes)
CACHE_TTL_CITIES=21600

# CACHE_TTL_BUILDINGS - Buildings with geolocation
# 43200 seconds = 12 hours (semi-static reference data)
CACHE_TTL_BUILDINGS=43200

# CACHE_TTL_ALL - All blackouts list
# 900 seconds = 15 minutes (frequently updated real-time data)
CACHE_TTL_ALL=900

# ============================================
# Redis Health Check Configuration
# ============================================

# REDIS_HEALTH_ALERT_COOLDOWN - Cooldown between health alerts (milliseconds)
# 300000 ms = 5 minutes (prevents alert spam in monitoring)
REDIS_HEALTH_ALERT_COOLDOWN=300000

# REDIS_HEALTH_MAX_RETRY_TIME - Maximum time to keep retrying (milliseconds)
# 3600000 ms = 1 hour (circuit breaker timeout)
REDIS_HEALTH_MAX_RETRY_TIME=3600000

# REDIS_HEALTH_RETRY_DELAY - Delay between retry attempts (milliseconds)
# 3000 ms = 3 seconds (exponential backoff starting point)
REDIS_HEALTH_RETRY_DELAY=3000

# REDIS_HEALTH_MAX_FAILURES - Max consecutive failures before alert
# Triggers critical alert after 3 failed connection attempts
REDIS_HEALTH_MAX_FAILURES=3

# ============================================
# Automated Backup System
# ============================================
# Production backup configuration for data protection

# BACKUP_INTERVAL - Interval between automatic backups (seconds)
# 43200 seconds = 12 hours (twice daily: 00:00 and 12:00)
# Balances between data safety and storage/performance
BACKUP_INTERVAL=43200

# KEEP_BACKUPS - Number of backup files to retain
# 30 backups = 15 days of history with 12-hour intervals
# Automatically deletes older backups to manage storage
KEEP_BACKUPS=30

# ============================================
# Database Migrations
# ============================================

# RUN_MIGRATIONS - Auto-run migrations on application startup
# true = automatically apply pending migrations in production
# false = manual migration control (use npm run migration:run)
# Recommended: true for seamless deployments
RUN_MIGRATIONS=true

# ============================================
# Debugging & Logging
# ============================================
# Minimal logging for production performance

# DEBUG - Enable debug mode
# false = production mode (minimal logging, better performance)
# Only set to true when troubleshooting production issues
DEBUG=false

# LOG_LEVEL - Logging level
# Options: debug, info, warn, error
# 'error' = log only errors (recommended for production)
# 'warn' = log warnings and errors (more visibility)
LOG_LEVEL=error

# ============================================
# TypeORM Entity Generator (Disabled in Production)
# ============================================
# Entity generation should only be used in development
# Keep these commented out in production for security

# TYPEORM_GEN_HOST - Database host for entity generation
# TYPEORM_GEN_HOST=

# TYPEORM_GEN_PORT - Database port for entity generation
# TYPEORM_GEN_PORT=

# TYPEORM_GEN_DATABASE - Database name for entity generation
# TYPEORM_GEN_DATABASE=

# TYPEORM_GEN_USER - Database user for entity generation
# TYPEORM_GEN_USER=

# TYPEORM_GEN_PASSWORD - Database password for entity generation
# TYPEORM_GEN_PASSWORD=
