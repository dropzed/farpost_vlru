# ===========================================
# Production Environment - Full Stack
# ===========================================

# Application
NODE_ENV=production
PORT=3000
BUILD_TARGET=production
SWAGGER_PATH=api

# Database (PostgreSQL) - ⚠️ CHANGE PASSWORDS IN PRODUCTION!
POSTGRES_HOST=db-postgres
POSTGRES_PORT=5432
POSTGRES_USER=produser
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_123
POSTGRES_DB=blackouts

# Redis Cache - ⚠️ SET STRONG PASSWORD IN PRODUCTION!
REDIS_HOST=redis-prod
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD_456
REDIS_TTL=3600
REDIS_MAX_ITEMS=1000
REDIS_MAXMEMORY=2gb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# Cache TTL (in seconds) - Backend
CACHE_TTL_DECEMBER_2019=86400
CACHE_TTL_TYPES=3600
CACHE_TTL_CITIES=21600
CACHE_TTL_BUILDINGS=43200
CACHE_TTL_ALL=900

# Redis Health Check Settings
REDIS_HEALTH_ALERT_COOLDOWN=300000  # 5 minutes in ms
REDIS_HEALTH_MAX_RETRY_TIME=3600000 # 1 hour in ms
REDIS_HEALTH_RETRY_DELAY=3000       # 3 seconds in ms
REDIS_HEALTH_MAX_FAILURES=3         # Max consecutive failures before alert

# Default Redis Hosts (fallback)
REDIS_HOST_DEV=redis-dev
REDIS_HOST_PROD=redis-prod

# Backup Settings
BACKUP_INTERVAL=43200
KEEP_BACKUPS=30

# Migrations
RUN_MIGRATIONS=true  # Auto-run migrations on startup in production

# Debug
DEBUG=false
LOG_LEVEL=error

# Frontend (Future)
# VITE_API_URL=https://yourdomain.com/api
# VITE_APP_TITLE=Vladivostok Blackouts

# API Documentation
SWAGGER_PATH=api

# Monitoring (required in production)
MONITORING_WEBHOOK_URL=

# TypeORM Entity Generator (disable in production)
# TYPEORM_GEN_HOST=
# TYPEORM_GEN_PORT=
# TYPEORM_GEN_DATABASE=
# TYPEORM_GEN_USER=
# TYPEORM_GEN_PASSWORD=
