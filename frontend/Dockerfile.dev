FROM node:20-alpine

# Устанавливаем pnpm
RUN npm install -g pnpm

WORKDIR /app

# Копируем файлы зависимостей
COPY package.json pnpm-lock.yaml* ./

# Устанавливаем зависимости
RUN pnpm install

# Копируем исходный код
COPY . .

# Открываем порт 8080
EXPOSE 8080

# Запускаем в режиме разработки
CMD ["pnpm", "run", "dev", "--host", "0.0.0.0"]